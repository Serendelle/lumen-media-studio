# ---------------------------------------------------------------------------
# Lumière Media Studio — local configuration template
#
# Copy this file to ".env" in the repository root and fill in your values.
# ".env" is git-ignored and must NEVER be committed or shared publicly.
# The backend reads it at startup; the frontend never sees any of these values.
# ---------------------------------------------------------------------------

# --- AI (DeepSeek, OpenAI-compatible). Plain-text local storage is intended. ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional: outbound proxy for the DeepSeek API only, e.g. http://127.0.0.1:7890 (leave empty for a direct connection)
DEEPSEEK_PROXY=

# --- Security ---
# Long random string used to sign login tokens. scripts/start-windows.ps1 generates one if missing.
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_TTL_HOURS=72
APP_ALLOW_REGISTRATION=true

# --- Server ---
SERVER_PORT=8080
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (SQLite database + uploaded/processed files live here) ---
APP_DATA_DIR=./data
APP_RETENTION_HOURS=24
APP_MAX_UPLOAD_MB=2048

# --- Processing limits ---
APP_MEDIA_CONCURRENCY=2
APP_USER_ACTIVE_LIMIT=4
APP_TASK_TIMEOUT_MIN=60

# --- External tools: leave empty to auto-detect (PATH + winget / default install dirs) ---
FFMPEG_PATH=
FFPROBE_PATH=
EXIFTOOL_PATH=
MAGICK_PATH=
GHOSTSCRIPT_PATH=
REMBG_PATH=
CONDA_PATH=
REMBG_ENV=rembg-env
REMBG_MODEL=u2net
# Document Studio: LibreOffice (soffice.com) for DOCX/XLSX -> PDF, Chrome or Edge for HTML -> PDF.
# Leave empty to auto-detect (C:\Program Files\LibreOffice, D:\LibreOffice, Chrome, then Edge).
SOFFICE_PATH=
CHROMIUM_PATH=

# --- Learning player ---
# Speech recognition: Alibaba Cloud Model Studio (百炼) Paraformer. Create a key in the Model Studio console.
# The audio is uploaded to Model Studio's temporary storage (deleted after 48 h); the key stays on this server.
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_ASR_MODEL=paraformer-v2
# Local OCR (RapidOCR): a Python environment with `rapidocr` installed. Empty = auto-detect D:\LumenTools\ocr-venv.
OCR_PYTHON=
LESSON_KEYFRAME_INTERVAL_SEC=3
LESSON_MAX_DURATION_MIN=120
