# Generated production config is deploy/.env (ignored by Git and Docker).
# Run: python3 deploy/init-config.py --origin https://lumen.example.com
COMPOSE_PROJECT_NAME=lumen
LUMEN_RELEASE=local
LUMEN_PUBLIC_ORIGIN=https://lumen.example.com
# Bootstrap over an SSH tunnel first; change to 1 after placing a real TLS certificate.
LUMEN_HTTPS=0
LUMEN_BIND_IP=127.0.0.1
LUMEN_HTTP_PORT=8080
LUMEN_TLS_BIND_IP=0.0.0.0
LUMEN_TLS_DIR=./data/deploy/tls

LUMEN_DB_PASSWORD=GENERATE_DATABASE_PASSWORD
APP_JWT_SECRET=GENERATE_JWT_SECRET
APP_JWT_TTL_HOURS=72
# Enable briefly to create the owner and invited accounts, then disable and recreate api.
APP_ALLOW_REGISTRATION=false

APP_RETENTION_HOURS=168
APP_MAX_UPLOAD_MB=1024
APP_MEDIA_CONCURRENCY=1
APP_MEDIA_QUEUE=20
APP_USER_ACTIVE_LIMIT=3
APP_FFMPEG_THREADS=2
APP_TASK_TIMEOUT_MIN=30
APP_MIN_FREE_DISK_MB=10240

# Optional, blank means unavailable. Never place these values in frontend build arguments.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PROXY=
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_PROXY=
